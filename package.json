{
  "name": "egg-cooker",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "A simple, science-informed egg timer with an animated cooking illustration.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrwittm/egg-cooker.git"
  },
  "homepage": "https://chrwittm.github.io/egg-cooker/",
  "bugs": {
    "url": "https://github.com/chrwittm/egg-cooker/issues"
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.domain.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run format:check && npm run lint && npm run check && npm run check:docs && npm test && npm run build",
    "verify:all": "npm run verify && npm run test:e2e",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
